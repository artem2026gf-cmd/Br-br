local skinTitles = {
    Pistol = { "Pistols", "coin" }, SMG = { "SMGs", "zap" }, Rifle = { "Rifles", "crosshair" },
    Sniper = { "Snipers", "target" }, Heavy = { "Heavy", "bomb" }, Shotgun = { "Shotguns", "bomb" },
    ["Machine Gun"] = { "Machine Guns", "zap" }, Knives = { "Knives", "swords" },
    Gloves = { "Gloves", "shield" }, Grenades = { "Grenades", "bomb" }, Gear = { "Gear", "gear" },
}

function xDTaraZ.UI.SkinGroup(tab, category, side)
    local title = skinTitles[category] or { category, "star" }
    local group = side == "Left" and tab:AddLeftGroupbox(title[1], title[2]) or tab:AddRightGroupbox(title[1], title[2])
    for _, weapon in ipairs(xDTaraZ.Skins.Items(category)) do
        if weapon == "-" then continue end
        local values = { "Default" }
        for _, skin in ipairs(xDTaraZ.Skins.List(weapon)) do values[#values + 1] = skin end
        group:AddDropdown("Skin_" .. weapon, { Text = weapon, Values = values, Default = xDTaraZ.Skins.Map[weapon] or "Default", Searchable = true, Callback = function(skin)
            xDTaraZ.Skins.Set(weapon, skin)
        end })
    end
end
function xDTaraZ.UI.SyncSkins()
    for _, category in ipairs(xDTaraZ.Skins.Categories()) do
        for _, weapon in ipairs(xDTaraZ.Skins.Items(category)) do
            local picker = Library.Options["Skin_" .. weapon]
            if picker then picker:SetValue(xDTaraZ.Skins.Map[weapon] or "Default") end
        end
    end
end
function xDTaraZ.UI.BuildSkins(window)
    local tab = window:AddTab(T("Skins", "Skins"), "star", T("Any skin, only on your screen", "Any skin, only on your screen"))
    local main = tab:AddLeftGroupbox(T("Skin Changer", "Skin Changer"), "star")
    main:AddToggle("SkinChanger", { Text = T("Skin changer", "Skin changer"), Description = T("Pick a skin below and it shows right away", "Pick a skin below and it shows right away") })
    main:AddButton({ Text = T("Rarest On Everything", "Rarest On Everything"), Style = "Primary", Func = xDTaraZ.UI.Detach(function()
        local count = xDTaraZ.Skins.SetAll(function(list) return list[1] end)
        xDTaraZ.UI.SyncSkins()
        Library:Notify("Skins", "Set " .. count .. " items", 3, "Success")
    end) })
    main:AddButton({ Text = T("Random", "Random"), Func = xDTaraZ.UI.Detach(function()
        xDTaraZ.Skins.SetAll(function(list) return list[math.random(#list)] end)
        xDTaraZ.UI.SyncSkins()
    end) }):AddButton({ Text = T("Reset All", "Reset All"), Style = "Danger", Func = xDTaraZ.UI.Detach(function()
        table.clear(xDTaraZ.Skins.Map)
        xDTaraZ.Skins.Save()
        xDTaraZ.UI.SyncSkins()
    end) })
    local gear = { Knives = "Right", Gloves = "Left", Grenades = "Right", Gear = "Left" }
    for _, category in ipairs({ "Knives", "Gloves", "Grenades", "Gear" }) do
        xDTaraZ.Util.Try("skins " .. category, xDTaraZ.UI.SkinGroup, tab, category, gear[category])
    end
    local guns = window:AddTab(T("Gun Skins", "Gun Skins"), "crosshair", T("Skins for every gun", "Skins for every gun"))
    local side = "Left"
    local ok, categories = pcall(xDTaraZ.Skins.Categories)
    for _, category in ipairs(ok and categories or {}) do
        if gear[category] then continue end
        xDTaraZ.Util.Try("skins " .. category, xDTaraZ.UI.SkinGroup, guns, category, side)
        side = side == "Left" and "Right" or "Left"
    end
end

